# ==============================================================================
# INNFINDER - BIẾN MÔI TRƯỜNG MẪU (BACKEND .ENV.EXAMPLE)
# Hướng dẫn: Copy file này thành ".env" và điền các khóa bí mật của bạn.
# ==============================================================================

# 1. CỔNG DỊCH VỤ MÁY CHỦ BACKEND
SERVER_PORT=8080

# 2. CƠ SỞ DỮ LIỆU ĐÁM MÂY (TIDB / MARIADB CLOUD) - ƯU TIÊN SỐ 1
INNFINDER_CLOUD_DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
INNFINDER_CLOUD_DB_PORT=4000
INNFINDER_CLOUD_DB_URL=jdbc:mariadb://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/innfinder_db?sslMode=verify-full&useUnicode=true&characterEncoding=utf8mb4
INNFINDER_CLOUD_DB_USER=your_cloud_user
INNFINDER_CLOUD_DB_PASSWORD=your_cloud_password

# 3. CƠ SỞ DỮ LIỆU DOCKER LOCAL (MARIADB 11.2) - DỰ PHÒNG KHI MẤT MẠNG
INNFINDER_LOCAL_DB_URL=jdbc:mariadb://localhost:3307/innfinder_db?useUnicode=true&characterEncoding=utf8mb4
INNFINDER_LOCAL_DB_USER=innfinder_user
INNFINDER_LOCAL_DB_PASSWORD=innfinder_password

# 4. KHÓA BẢO MẬT XÁC THỰC JWT
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MILLISECONDS=86400000

# 5. DỊCH VỤ LƯU TRỮ HÌNH ẢNH CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
