1.6;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-52" target="screen-71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5350" y="550"/><mxPoint x="5710" y="550"/></Array></mxGeometry></mxCell><mxCell id="edge-74" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=1.6;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-71" target="screen-72"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5593" y="660"/><mxPoint x="5593" y="778"/><mxPoint x="5710" y="778"/></Array></mxGeometry></mxCell><mxCell id="edge-75" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=1.6;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-52" target="screen-73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5350" y="550"/><mxPoint x="5950" y="550"/></Array></mxGeometry></mxCell><mxCell id="edge-76" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=1.6;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-73" target="screen-74"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5833" y="660"/><mxPoint x="5833" y="778"/><mxPoint x="5950" y="778"/></Array></mxGeometry></mxCell><mxCell id="edge-77" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=1.6;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-52" target="screen-75"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5350" y="550"/><mxPoint x="6190" y="550"/></Array></mxGeometry></mxCell><mxCell id="edge-78" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=1.6;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-52" target="screen-76"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5350" y="550"/><mxPoint x="6430" y="550"/></Array></mxGeometry></mxCell><mxCell id="edge-79" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=1.6;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-76" target="screen-77"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6313" y="660"/><mxPoint x="6313" y="778"/><mxPoint x="6430" y="778"/></Array></mxGeometry></mxCell><mxCell id="edge-80" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=1.6;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="screen-81" target="screen-0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="310"/><mxPoint x="1300" y="310"/></Array></mxGeometry></mxCell><mxCell id="text-3" value="SƠ ĐỒ LUỒNG MÀN HÌNH WEB INNFINDER" style="text;html=0;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=34;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="22" width="4400" height="42" as="geometry"/></mxCell><mxCell id="text-4" value="Phân luồng theo người dùng · develop ed05940 · 27/11/2026" style="text;html=0;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="4400" height="25" as="geometry"/></mxCell><mxCell id="text-5" value="KHACH_HANG · Khách vãng lai xem được nhóm khám phá" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#15803d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="350" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-6" value="Đã đăng nhập · user.chuTro = true" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#2563eb;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2618" y="350" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-7" value="Đã đăng nhập · vaiTro = QUAN_TRI" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#dc2626;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="4168" y="350" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-8" value="QUY ƯỚC · Xanh lá = khách hàng / công khai · Xanh dương = chủ trọ · Đỏ = quản trị · Viền đứt = hộp thoại · Viền liền = màn hình hoặc tab có chú thích." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2073" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-9" value="Mũi tên từ điểm vào tới các màn hình biểu thị truy cập qua menu của layout. Nhánh dưới thể hiện màn hình con và các thao tác liên quan. Các nút đóng/quay lại dùng trang cha." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2101" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-10" value="LUỒNG ĐẶT LỊCH · Chi tiết phòng hoặc thẻ InnAi → Chọn ngày giờ → Nộp cọc → Danh sách lịch hẹn → Chi tiết lịch hẹn → Các quyết định theo trạng thái." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2129" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-11" value="LUỒNG Ở GHÉP · Tạo bài tại danh sách: chọn phiếu thuê đủ điều kiện → Form đăng bài → Chi tiết bài. Khách khác gửi đơn → Chủ bài duyệt/từ chối → Chat khi được phép." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2157" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-12" value="QUYỀN · Chưa đăng nhập khi vào route bảo vệ: mở /login với returnUrl. Chủ trọ vào nhóm ở ghép: chuyển /landlord/dashboard. Admin vào /favorites: chuyển /admin/dashboard." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2185" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-13" value="ĐĂNG NHẬP · Ưu tiên returnUrl/from hợp lệ. Nếu thiếu: khách tới /, chủ trọ tới /landlord/dashboard, admin tới /admin/dashboard. Chủ trọ còn có thể dùng phần khám phá." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2213" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-14" value="ĐỐI CHIẾU · Quên mật khẩu đang mô phỏng OTP bằng setTimeout. /wallet tồn tại trong router. /appointments/schedule và /appointments/deposit có biến thể không có ID." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2241" width="5800" height="23" as="geometry"/></mxCell><mxCell id="text-15" value="URL CŨ · /customer/*, /booking/*, /rentals được router giữ để tương thích. Chúng dùng lại các màn hình trên. Route không khớp chuyển về /. Bản vẽ dựa vào mã nguồn, chưa chạy toàn bộ vai trò." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="780" y="2269" width="5800" height="23" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>